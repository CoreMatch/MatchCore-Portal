---
import Layout from '../../layouts/Layout.astro';
import Banner from '../../components/Banner.astro';
import Header from '../../components/Header.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { siteConfig } from '../../site';
import { hrpauth } from '../../i18n/pages/hrpauth';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang, hrpauth);

const features = [
  { title: t('features.item1.title'), description: t('features.item1.desc'), icon: 'ID' },
  { title: t('features.item2.title'), description: t('features.item2.desc'), icon: 'SK' },
  { title: t('features.item3.title'), description: t('features.item3.desc'), icon: 'DX' },
  { title: t('features.item4.title'), description: t('features.item4.desc'), icon: 'API' },
  { title: t('features.item5.title'), description: t('features.item5.desc'), icon: 'OPS' },
  { title: t('features.item6.title'), description: t('features.item6.desc'), icon: 'OSS' },
];

const highlights = [
  { title: t('highlights.item1.title'), description: t('highlights.item1.desc') },
  { title: t('highlights.item2.title'), description: t('highlights.item2.desc') },
];

const resources = [
  { title: t('resources.docs.title'), description: t('resources.docs.desc'), href: siteConfig.docsUrl },
  { title: t('resources.demo.title'), description: t('resources.demo.desc'), href: siteConfig.demoUrl },
  { title: t('resources.source.title'), description: t('resources.source.desc'), href: siteConfig.repoUrl },
];
---

<Layout title={t('meta.title')} description={t('meta.description')}>
  <Header />

  <main>
    <Banner pageUi={hrpauth} />

    <section id="features" class="bg-gray-50 py-20">
      <div class="container mx-auto px-4">
        <div class="mx-auto mb-16 max-w-3xl text-center">
          <h2 class="mb-4 text-3xl font-bold text-gray-900">{t('features.title')}</h2>
          <p class="text-gray-600">{t('features.description')}</p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {features.map((feature) => (
            <div class="rounded-2xl border border-gray-100 bg-white p-8 shadow-sm transition-shadow hover:shadow-md">
              <div class="mb-6 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-sm font-bold text-blue-700">
                {feature.icon}
              </div>
              <h3 class="mb-3 text-xl font-bold text-gray-900">{feature.title}</h3>
              <p class="leading-relaxed text-gray-600">{feature.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white py-20">
      <div class="container mx-auto px-4">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <h2 class="mb-4 text-3xl font-bold text-gray-900">{t('highlights.title')}</h2>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          {highlights.map((highlight) => (
            <div class="rounded-2xl border border-blue-100 bg-blue-50/60 p-8">
              <h3 class="mb-3 text-xl font-bold text-gray-900">{highlight.title}</h3>
              <p class="leading-relaxed text-gray-700">{highlight.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="about" class="bg-gray-950 py-20 text-white">
      <div class="container mx-auto px-4">
        <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-start">
          <div class="max-w-3xl">
            <div class="mb-4 inline-flex items-center rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-sm text-blue-200">
              {t('about.status')}
            </div>
            <h2 class="mb-6 text-3xl font-bold">{t('about.title')}</h2>
            <p class="mb-5 leading-8 text-gray-300">{t('about.p1')}</p>
            <p class="leading-8 text-gray-300">{t('about.p2')}</p>
          </div>

          <div class="rounded-3xl border border-white/10 bg-white/5 p-8">
            <div class="space-y-6">
              <div>
                <p class="text-sm uppercase tracking-[0.2em] text-gray-400">{t('nav.docs')}</p>
                <a href={siteConfig.docsUrl} target="_blank" rel="noreferrer" class="mt-2 block text-lg font-semibold text-white hover:text-blue-200">
                  {siteConfig.docsUrl}
                </a>
              </div>
              <div>
                <p class="text-sm uppercase tracking-[0.2em] text-gray-400">{t('nav.demo')}</p>
                <a href={siteConfig.demoUrl} target="_blank" rel="noreferrer" class="mt-2 block text-lg font-semibold text-white hover:text-blue-200">
                  {siteConfig.demoUrl}
                </a>
              </div>
              <div>
                <p class="text-sm uppercase tracking-[0.2em] text-gray-400">{t('nav.source')}</p>
                <a href={siteConfig.repoUrl} target="_blank" rel="noreferrer" class="mt-2 block text-lg font-semibold text-white hover:text-blue-200">
                  {siteConfig.repoUrl}
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="resources" class="bg-white py-20">
      <div class="container mx-auto px-4">
        <div class="mx-auto mb-16 max-w-3xl text-center">
          <h2 class="mb-4 text-3xl font-bold text-gray-900">{t('resources.title')}</h2>
          <p class="text-gray-600">{t('resources.description')}</p>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
          {resources.map((resource) => (
            <a
              href={resource.href}
              target="_blank"
              rel="noreferrer"
              class="group rounded-2xl border border-gray-100 bg-gray-50 p-8 transition-all hover:-translate-y-1 hover:border-blue-200 hover:bg-white hover:shadow-lg"
            >
              <h3 class="mb-3 text-xl font-bold text-gray-900">{resource.title}</h3>
              <p class="mb-6 leading-relaxed text-gray-600">{resource.description}</p>
              <span class="font-semibold text-blue-600 transition-colors group-hover:text-blue-700">
                {t('resources.action')}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-gray-100 bg-white py-12">
    <div class="container mx-auto flex flex-col gap-6 px-4 md:flex-row md:items-center md:justify-between">
      <p class="text-sm text-gray-500">{t('footer.rights')}</p>

      <div class="flex flex-wrap items-center gap-5 text-sm font-medium text-gray-600">
        <a href={siteConfig.docsUrl} target="_blank" rel="noreferrer" class="hover:text-blue-600">{t('footer.docs')}</a>
        <a href={siteConfig.demoUrl} target="_blank" rel="noreferrer" class="hover:text-blue-600">{t('footer.demo')}</a>
        <a href={siteConfig.repoUrl} target="_blank" rel="noreferrer" class="hover:text-blue-600">{t('footer.source')}</a>
        <a href={siteConfig.communityUrl} target="_blank" rel="noreferrer" class="hover:text-blue-600">{t('footer.community')}</a>
      </div>
    </div>
  </footer>
</Layout>
