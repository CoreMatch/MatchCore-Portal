---
import Layout from '../../layouts/Layout.astro';
import Banner from '../../components/Banner.astro';
import Header from '../../components/Header.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { siteConfig, siteConfigHrpauth } from '../../site';
import hrpauth from '../../i18n/pages/hrpauth.json';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang, hrpauth);

const features = [
  { title: t('features.item1.title'), description: t('features.item1.desc'), icon: 'SSO' },
  { title: t('features.item2.title'), description: t('features.item2.desc'), icon: 'REG' },
  { title: t('features.item3.title'), description: t('features.item3.desc'), icon: '2FA' },
  { title: t('features.item4.title'), description: t('features.item4.desc'), icon: 'ACCT' },
  { title: t('features.item5.title'), description: t('features.item5.desc'), icon: 'OAUTH' },
  { title: t('features.item6.title'), description: t('features.item6.desc'), icon: 'OSS' },
];

const highlights = [
  { title: t('highlights.item1.title'), description: t('highlights.item1.desc') },
  { title: t('highlights.item2.title'), description: t('highlights.item2.desc') },
];

const resources = [
  { title: t('resources.docs.title'), description: t('resources.docs.desc'), href: siteConfigHrpauth.hadocsUrl },
  { title: t('resources.demo.title'), description: t('resources.demo.desc'), href: siteConfigHrpauth.hademoUrl },
  { title: t('resources.source.title'), description: t('resources.source.desc'), href: siteConfigHrpauth.harepoUrl },
];
---

<Layout title={t('meta.title')} description={t('meta.description')}>
  <Header />

  <main>
    <Banner
      pageUi={hrpauth}
      projectName={siteConfigHrpauth.haprojectName}
      primaryHref={siteConfigHrpauth.hademoUrl}
      secondaryHref={siteConfigHrpauth.hadocsUrl}
    />

    <section id="features" class="border-b border-arena-edge bg-arena-base py-20">
      <div class="container mx-auto px-4">
        <div class="mx-auto mb-16 max-w-3xl text-center">
          <h2 class="mb-4 text-3xl font-bold text-arena-ink">{t('features.title')}</h2>
          <p class="text-arena-muted">{t('features.description')}</p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {features.map((feature) => (
            <div class="rounded-lg border border-arena-edge bg-arena-panel p-8">
              <div class="mb-6 inline-flex h-12 w-12 items-center justify-center rounded-md border border-arena-edge-strong bg-arena-raised text-sm font-bold text-arena-accent">
                {feature.icon}
              </div>
              <h3 class="mb-3 text-xl font-bold text-arena-ink">{feature.title}</h3>
              <p class="leading-relaxed text-arena-muted">{feature.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b border-arena-edge bg-arena-base py-20">
      <div class="container mx-auto px-4">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <h2 class="mb-4 text-3xl font-bold text-arena-ink">{t('highlights.title')}</h2>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          {highlights.map((highlight) => (
            <div class="rounded-lg border border-arena-edge bg-arena-panel p-8">
              <h3 class="mb-3 text-xl font-bold text-arena-ink">{highlight.title}</h3>
              <p class="leading-relaxed text-arena-muted">{highlight.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="about" class="border-b border-arena-edge bg-arena-panel py-20 text-arena-ink">
      <div class="container mx-auto px-4">
        <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-start">
          <div class="max-w-3xl">
            <div class="mb-4 inline-flex items-center rounded-md border border-arena-edge-strong bg-arena-raised px-4 py-1.5 text-sm text-arena-muted">
              {t('about.status')}
            </div>
            <h2 class="mb-6 text-3xl font-bold">{t('about.title')}</h2>
            <p class="mb-5 leading-8 text-arena-muted">{t('about.p1')}</p>
            <p class="leading-8 text-arena-muted">{t('about.p2')}</p>
          </div>

          <div class="rounded-lg border border-arena-edge bg-arena-base p-8">
            <div class="space-y-6">
              <div>
                <p class="text-sm uppercase tracking-[0.2em] text-arena-faint">{t('nav.docs')}</p>
                <a href={siteConfigHrpauth.hadocsUrl} target="_blank" rel="noreferrer" class="mt-2 block text-lg font-semibold text-arena-ink hover:text-arena-accent">
                  {siteConfigHrpauth.hadocsUrl}
                </a>
              </div>
              <div>
                <p class="text-sm uppercase tracking-[0.2em] text-arena-faint">{t('nav.demo')}</p>
                <a href={siteConfigHrpauth.hademoUrl} target="_blank" rel="noreferrer" class="mt-2 block text-lg font-semibold text-arena-ink hover:text-arena-accent">
                  {siteConfigHrpauth.hademoUrl}
                </a>
              </div>
              <div>
                <p class="text-sm uppercase tracking-[0.2em] text-arena-faint">{t('nav.source')}</p>
                <a href={siteConfigHrpauth.harepoUrl} target="_blank" rel="noreferrer" class="mt-2 block text-lg font-semibold text-arena-ink hover:text-arena-accent">
                  {siteConfigHrpauth.harepoUrl}
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="resources" class="bg-arena-base py-20">
      <div class="container mx-auto px-4">
        <div class="mx-auto mb-16 max-w-3xl text-center">
          <h2 class="mb-4 text-3xl font-bold text-arena-ink">{t('resources.title')}</h2>
          <p class="text-arena-muted">{t('resources.description')}</p>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
          {resources.map((resource) => (
            <a
              href={resource.href}
              target="_blank"
              rel="noreferrer"
              class="group rounded-lg border border-arena-edge bg-arena-panel p-8 transition-colors hover:border-arena-edge-strong"
            >
              <h3 class="mb-3 text-xl font-bold text-arena-ink">{resource.title}</h3>
              <p class="mb-6 leading-relaxed text-arena-muted">{resource.description}</p>
              <span class="font-semibold text-arena-accent">
                {t('resources.action')} →
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-arena-edge bg-arena-base py-12">
    <div class="container mx-auto flex flex-col gap-6 px-4 md:flex-row md:items-center md:justify-between">
      <p class="text-sm text-arena-faint">{t('footer.rights')}</p>

      <div class="flex flex-wrap items-center gap-5 text-sm font-medium text-arena-muted">
        <a href={siteConfigHrpauth.hadocsUrl} target="_blank" rel="noreferrer" class="hover:text-arena-ink">{t('footer.docs')}</a>
        <a href={siteConfigHrpauth.hademoUrl} target="_blank" rel="noreferrer" class="hover:text-arena-ink">{t('footer.demo')}</a>
        <a href={siteConfigHrpauth.harepoUrl} target="_blank" rel="noreferrer" class="hover:text-arena-ink">{t('footer.source')}</a>
        <a href={siteConfigHrpauth.hacommunityUrl} target="_blank" rel="noreferrer" class="hover:text-arena-ink">{t('footer.community')}</a>
        <a href={`mailto:${siteConfig.contactEmail}`} class="hover:text-arena-ink">{t('footer.contact')}</a>
      </div>
    </div>
  </footer>
</Layout>
