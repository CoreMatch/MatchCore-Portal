---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import { languages } from '../i18n/ui';
import { siteConfig } from '../site';

interface Props {
  pageUi?: any;
}

const { pageUi } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang, pageUi);
const translatePath = useTranslatedPath(lang);

const usageUrl = `${siteConfig.repoUrl}/blob/main/USAGE.md`;

const navItems = [
  { name: t('nav.modes'), href: '#modes' },
  { name: t('nav.ranking'), href: '#ranking' },
  { name: t('nav.start'), href: '#start' },
  { name: t('nav.account'), href: '#account' },
];

const modes = [
  {
    title: t('modes.m1.title'),
    team: t('modes.m1.team'),
    match: t('modes.m1.match'),
    reward: t('modes.m1.reward'),
    alt: t('img.m1.alt'),
    img1x: '/images/mode-1v1-1x.webp',
    img2x: '/images/mode-1v1-2x.webp',
  },
  {
    title: t('modes.m2.title'),
    team: t('modes.m2.team'),
    match: t('modes.m2.match'),
    reward: t('modes.m2.reward'),
    alt: t('img.m2.alt'),
    img1x: '/images/mode-2v2-1x.webp',
    img2x: '/images/mode-2v2-2x.webp',
  },
];

const rankingPoints = [
  { title: t('ranking.why.title'), desc: t('ranking.why.desc') },
  { title: t('ranking.how.title'), desc: t('ranking.how.desc') },
  { title: t('ranking.where.title'), desc: t('ranking.where.desc') },
];

const steps = [
  { title: t('start.s1.title'), desc: t('start.s1.desc') },
  { title: t('start.s2.title'), desc: t('start.s2.desc') },
  { title: t('start.s3.title'), desc: t('start.s3.desc') },
];

const accountItems = [
  { title: t('account.a1.title'), desc: t('account.a1.desc') },
  { title: t('account.a2.title'), desc: t('account.a2.desc') },
  { title: t('account.a3.title'), desc: t('account.a3.desc') },
];
---

<!-- Top bar -->
<header class="sticky top-0 z-50 w-full border-b border-arena-edge bg-arena-base/95 backdrop-blur-md">
  <div class="container mx-auto flex h-16 items-center justify-between px-4">
    <a href={translatePath('/')} class="flex items-center gap-2">
      <div class="flex h-8 w-8 items-center justify-center rounded-md bg-arena-accent font-bold text-white">M</div>
      <span class="text-xl font-bold tracking-tight text-arena-ink">{siteConfig.projectName}</span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex">
      {navItems.map((item) => (
        <a href={item.href} class="text-sm font-medium text-arena-muted transition-colors hover:text-arena-ink">
          {item.name}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <div class="flex items-center gap-1 border-r border-arena-edge pr-3">
        {Object.entries(languages).map(([l]) => (
          <a
            href={translatePath(Astro.url.pathname.replace(`/${lang}`, '') || '/', l)}
            class={`rounded-md px-2 py-1 text-xs transition-colors ${lang === l ? 'bg-arena-raised font-bold text-arena-ink' : 'text-arena-faint hover:text-arena-ink'}`}
          >
            {l === 'zh-cn' ? '中' : 'EN'}
          </a>
        ))}
      </div>
      <a
        href={siteConfig.demoUrl}
        target="_blank"
        rel="noreferrer"
        class="hidden rounded-md border border-arena-edge-strong px-4 py-2 text-sm font-medium text-arena-ink transition-colors hover:border-arena-faint sm:block"
      >
        {t('nav.login')}
      </a>
      <a
        href={siteConfig.demoUrl}
        target="_blank"
        rel="noreferrer"
        class="rounded-md bg-arena-accent px-4 py-2 text-sm font-semibold text-white transition-opacity hover:opacity-90"
      >
        {t('nav.signup')}
      </a>
    </div>
  </div>
</header>

<main>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-arena-edge">
    <picture>
      <source media="(max-width: 767px)" srcset="/images/hero-portrait.webp" type="image/webp" />
      <img
        src="/images/hero-wide-1x.webp"
        srcset="/images/hero-wide-1x.webp 1446w, /images/hero-wide-2x.webp 2892w"
        sizes="100vw"
        width="2892"
        height="1240"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        alt={t('img.hero.alt')}
        class="absolute inset-0 h-full w-full object-cover"
      />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-t from-arena-base via-arena-base/75 to-arena-base/40"></div>
    <div class="container relative mx-auto px-4 py-24 md:py-32">
      <div class="mx-auto max-w-4xl text-center">
        <h1 class="mb-6 text-5xl font-extrabold leading-[1.05] tracking-tight text-arena-ink md:text-7xl">
          {t('hero.title')}
        </h1>
        <p class="mx-auto mb-10 max-w-2xl text-lg leading-relaxed text-arena-muted md:text-xl">
          {t('hero.subtitle')}
        </p>
        <div class="flex flex-col items-center gap-6">
          <a
            href={siteConfig.demoUrl}
            target="_blank"
            rel="noreferrer"
            class="w-full rounded-md bg-arena-accent px-10 py-4 text-base font-semibold text-white transition-opacity hover:opacity-90 sm:w-auto"
          >
            {t('hero.cta')}
          </a>
          <span
            data-arena-status
            data-state="pending"
            data-up={t('status.up')}
            data-down={t('status.down')}
            data-unknown={t('status.unknown')}
            data-pending={t('status.pending')}
            data-snapshot={t('status.snapshot')}
            data-rel-now={t('status.rel.now')}
            data-rel-min={t('status.rel.min')}
            data-rel-hour={t('status.rel.hour')}
            class="inline-flex items-center gap-2 rounded-md border border-arena-edge bg-arena-panel px-4 py-2 text-sm text-arena-muted"
          >
            <span data-dot class="h-2.5 w-2.5 rounded-full bg-arena-faint"></span>
            <span data-label>{t('status.pending')}</span>
          </span>
          <noscript>
            <a href={siteConfig.statusUrl} target="_blank" rel="noreferrer" class="text-sm text-arena-faint underline">
              {t('status.noscript')}
            </a>
          </noscript>
        </div>
      </div>
    </div>
  </section>

  <!-- Modes -->
  <section id="modes" class="border-b border-arena-edge">
    <div class="container mx-auto px-4 py-20">
      <h2 class="mb-10 text-3xl font-bold text-arena-ink md:text-4xl">{t('modes.title')}</h2>
      <div class="grid gap-6 lg:grid-cols-2">
        {modes.map((mode) => (
          <div class="group overflow-hidden rounded-lg border border-arena-edge bg-arena-panel transition-colors hover:border-arena-edge-strong">
            <div class="aspect-[16/10] overflow-hidden border-b border-arena-edge">
              <img
                src={mode.img1x}
                srcset={`${mode.img1x} 1192w, ${mode.img2x} 2384w`}
                sizes="(min-width: 1024px) 50vw, 100vw"
                width="2384"
                height="1490"
                loading="lazy"
                decoding="async"
                alt={mode.alt}
                class="h-full w-full object-cover"
              />
            </div>
            <div class="p-8">
              <h3 class="mb-6 text-2xl font-bold text-arena-ink">{mode.title}</h3>
              <dl class="space-y-4">
              <div>
                <dt class="mb-1 text-xs font-semibold uppercase tracking-[0.15em] text-arena-faint">{t('modes.label.team')}</dt>
                <dd class="leading-relaxed text-arena-muted">{mode.team}</dd>
              </div>
              <div>
                <dt class="mb-1 text-xs font-semibold uppercase tracking-[0.15em] text-arena-faint">{t('modes.label.match')}</dt>
                <dd class="leading-relaxed text-arena-muted">{mode.match}</dd>
              </div>
              <div>
                <dt class="mb-1 text-xs font-semibold uppercase tracking-[0.15em] text-arena-faint">{t('modes.label.reward')}</dt>
                <dd class="font-medium text-arena-ink">{mode.reward}</dd>
              </div>
              </dl>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Ranking -->
  <section id="ranking" class="relative overflow-hidden border-b border-arena-edge">
    <img
      src="/images/rank-bg-1x.webp"
      srcset="/images/rank-bg-1x.webp 1424w, /images/rank-bg-2x.webp 2848w"
      sizes="100vw"
      width="2848"
      height="949"
      loading="lazy"
      decoding="async"
      alt={t('img.rank.alt')}
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-arena-base/85"></div>
    <div class="container relative mx-auto px-4 py-20">
      <div class="grid items-start gap-12 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <h2 class="mb-8 text-3xl font-bold text-arena-ink md:text-4xl">{t('ranking.title')}</h2>
          <p class="max-w-md leading-relaxed text-arena-muted">{t('ranking.lede')}</p>
        </div>
        <div class="space-y-8">
          {rankingPoints.map((point, i) => (
            <div class="rounded-lg border border-arena-edge bg-arena-base p-6">
              <h3 class="mb-2 flex items-center gap-3 text-xl font-bold text-arena-ink">
                <span class="font-mono text-base text-arena-accent">{String(i + 1).padStart(2, '0')}</span>
                {point.title}
              </h3>
              <p class="leading-relaxed text-arena-muted">{point.desc}</p>
            </div>
          ))}
          <a
            href={siteConfig.ratingDocsUrl}
            target="_blank"
            rel="noreferrer"
            class="inline-block font-semibold text-arena-accent transition-opacity hover:opacity-80"
          >
            {t('rating.wiki')} →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Get started -->
  <section id="start" class="border-b border-arena-edge">
    <div class="container mx-auto px-4 py-20">
      <h2 class="mb-10 text-3xl font-bold text-arena-ink md:text-4xl">{t('start.title')}</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="flex flex-col rounded-lg border border-arena-edge bg-arena-panel p-8">
          <span class="mb-4 font-mono text-4xl font-bold text-arena-accent">1</span>
          <h3 class="mb-2 text-xl font-bold text-arena-ink">{steps[0].title}</h3>
          <p class="mb-6 flex-1 leading-relaxed text-arena-muted">{steps[0].desc}</p>
          <a href={siteConfig.demoUrl} target="_blank" rel="noreferrer" class="font-semibold text-arena-accent transition-opacity hover:opacity-80">
            {t('start.s1.action')} →
          </a>
        </div>
        <div class="flex flex-col rounded-lg border border-arena-edge bg-arena-panel p-8">
          <span class="mb-4 font-mono text-4xl font-bold text-arena-accent">2</span>
          <h3 class="mb-2 text-xl font-bold text-arena-ink">{steps[1].title}</h3>
          <p class="mb-6 flex-1 leading-relaxed text-arena-muted">{steps[1].desc}</p>
          <div class="flex flex-wrap gap-x-5 gap-y-2">
            <a href={siteConfig.repoUrl} target="_blank" rel="noreferrer" class="font-semibold text-arena-accent transition-opacity hover:opacity-80">
              {t('start.s2.action1')} →
            </a>
            <a href={usageUrl} target="_blank" rel="noreferrer" class="font-semibold text-arena-accent transition-opacity hover:opacity-80">
              {t('start.s2.action2')} →
            </a>
          </div>
        </div>
        <div class="flex flex-col rounded-lg border border-arena-edge bg-arena-panel p-8">
          <span class="mb-4 font-mono text-4xl font-bold text-arena-accent">3</span>
          <h3 class="mb-2 text-xl font-bold text-arena-ink">{steps[2].title}</h3>
          <p class="leading-relaxed text-arena-muted">{steps[2].desc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Account & security -->
  <section id="account" class="border-b border-arena-edge bg-arena-panel/40">
    <div class="container mx-auto px-4 py-20">
      <div class="mx-auto mb-10 max-w-3xl text-center">
        <h2 class="mb-3 text-3xl font-bold text-arena-ink md:text-4xl">{t('account.title')}</h2>
        <p class="text-arena-muted">{t('account.desc')}</p>
      </div>
      <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-3">
        {accountItems.map((item) => (
          <div class="rounded-lg border border-arena-edge bg-arena-base p-8">
            <h3 class="mb-3 text-xl font-bold text-arena-ink">{item.title}</h3>
            <p class="leading-relaxed text-arena-muted">{item.desc}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a
          href={siteConfig.demoUrl}
          target="_blank"
          rel="noreferrer"
          class="inline-block rounded-md bg-arena-accent px-8 py-4 text-base font-semibold text-white transition-opacity hover:opacity-90"
        >
          {t('account.cta')}
        </a>
      </div>
    </div>
  </section>

  <!-- Ecosystem -->
  <section id="ecosystem" class="border-b border-arena-edge">
    <div class="container mx-auto px-4 py-20">
      <h2 class="mb-10 text-3xl font-bold text-arena-ink md:text-4xl">{t('eco.title')}</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <a
          href={siteConfig.docsUrl}
          target="_blank"
          rel="noreferrer"
          class="group rounded-lg border border-arena-edge bg-arena-panel p-8 transition-colors hover:border-arena-edge-strong"
        >
          <h3 class="mb-3 text-xl font-bold text-arena-ink">{t('eco.wiki.title')}</h3>
          <p class="mb-6 leading-relaxed text-arena-muted">{t('eco.wiki.desc')}</p>
          <span class="font-semibold text-arena-accent">{t('resources.action')} →</span>
        </a>
        <a
          href={siteConfig.repoUrl}
          target="_blank"
          rel="noreferrer"
          class="group rounded-lg border border-arena-edge bg-arena-panel p-8 transition-colors hover:border-arena-edge-strong"
        >
          <h3 class="mb-3 text-xl font-bold text-arena-ink">{t('eco.source.title')}</h3>
          <p class="mb-6 leading-relaxed text-arena-muted">{t('eco.source.desc')}</p>
          <span class="font-semibold text-arena-accent">{t('resources.action')} →</span>
        </a>
        <div class="rounded-lg border border-arena-edge bg-arena-panel p-8">
          <h3 class="mb-3 text-xl font-bold text-arena-ink">{t('eco.status.title')}</h3>
          <p class="mb-6 leading-relaxed text-arena-muted">{t('eco.status.desc')}</p>
          <span
            data-arena-status
            data-state="pending"
            data-up={t('status.up')}
            data-down={t('status.down')}
            data-unknown={t('status.unknown')}
            data-pending={t('status.pending')}
            data-snapshot={t('status.snapshot')}
            data-rel-now={t('status.rel.now')}
            data-rel-min={t('status.rel.min')}
            data-rel-hour={t('status.rel.hour')}
            class="mb-4 inline-flex items-center gap-2 rounded-md border border-arena-edge bg-arena-base px-3 py-1.5 text-sm text-arena-muted"
          >
            <span data-dot class="h-2.5 w-2.5 rounded-full bg-arena-faint"></span>
            <span data-label>{t('status.pending')}</span>
          </span>
          <div>
            <a href={siteConfig.statusUrl} target="_blank" rel="noreferrer" class="text-sm font-semibold text-arena-accent transition-opacity hover:opacity-80">
              {t('eco.status.raw')} →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<footer class="bg-arena-base py-12">
  <div class="container mx-auto flex flex-col gap-6 px-4 md:flex-row md:items-center md:justify-between">
    <p class="text-sm text-arena-faint">{t('footer.rights')}</p>
    <div class="flex flex-wrap items-center gap-5 text-sm font-medium text-arena-muted">
      <a href={siteConfig.docsUrl} target="_blank" rel="noreferrer" class="hover:text-arena-ink">{t('footer.docs')}</a>
      <a href={siteConfig.demoUrl} target="_blank" rel="noreferrer" class="hover:text-arena-ink">{t('footer.demo')}</a>
      <a href={siteConfig.repoUrl} target="_blank" rel="noreferrer" class="hover:text-arena-ink">{t('footer.source')}</a>
      <a href={siteConfig.communityUrl} target="_blank" rel="noreferrer" class="hover:text-arena-ink">{t('footer.community')}</a>
      <a href={`mailto:${siteConfig.contactEmail}`} class="hover:text-arena-ink">{t('footer.contact')}</a>
    </div>
  </div>
</footer>

<!-- Service status probe: tries a live cross-origin read of the arena health
     endpoint (CORS-whitelisted for mcnb.dev / www.mcnb.dev), refreshing at most
     every 60s or when the page becomes visible again. On any failure, timeout
     (3s), or abnormal payload it falls back to /status.json — the deploy-time
     snapshot — and labels it as such; with neither source it says unknown and
     never claims "online". -->
<script is:inline>
  (function () {
    var LIVE = 'https://arena.mcnb.dev/api/status';
    var els = document.querySelectorAll('[data-arena-status]');
    var state = 'pending';
    var liveAt = 0;
    var snapAt = '';

    function label(el) {
      if (state === 'live') {
        var s = Math.floor((Date.now() - liveAt) / 1000);
        var rel;
        if (s < 60) rel = el.dataset.relNow;
        else if (s < 3600) rel = el.dataset.relMin.replace('{n}', String(Math.floor(s / 60)));
        else rel = el.dataset.relHour.replace('{n}', String(Math.floor(s / 3600)));
        return el.dataset.up + ' · ' + rel;
      }
      if (state === 'live-down') return el.dataset.down;
      if (state === 'snap-up') return el.dataset.up + ' · ' + el.dataset.snapshot + ' ' + snapAt;
      if (state === 'snap-down') return el.dataset.down + ' · ' + el.dataset.snapshot + ' ' + snapAt;
      if (state === 'unknown') return el.dataset.unknown;
      return el.dataset.pending;
    }

    function paint() {
      els.forEach(function (el) {
        el.dataset.state = state;
        el.querySelector('[data-label]').textContent = label(el);
      });
    }

    function snapshot() {
      fetch('/status.json', { cache: 'no-store' })
        .then(function (r) {
          if (!r.ok) throw new Error('snapshot missing');
          return r.json();
        })
        .then(function (j) {
          snapAt = (j && j.checked_at) || '';
          state = j && j.ok === true ? 'snap-up' : 'snap-down';
          paint();
        })
        .catch(function () {
          state = 'unknown';
          paint();
        });
    }

    function live() {
      var ctrl = typeof AbortController !== 'undefined' ? new AbortController() : null;
      var timer = ctrl ? setTimeout(function () { ctrl.abort(); }, 3000) : null;
      fetch(LIVE, { cache: 'no-store', signal: ctrl ? ctrl.signal : undefined })
        .then(function (r) {
          if (timer) clearTimeout(timer);
          if (!r.ok) throw new Error('http ' + r.status);
          return r.json();
        })
        .then(function (j) {
          if (j && j.success === true) {
            state = 'live';
            liveAt = Date.now();
          } else {
            state = 'live-down';
          }
          paint();
        })
        .catch(function () {
          if (timer) clearTimeout(timer);
          snapshot();
        });
    }

    live();
    setInterval(live, 60000);
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'visible') live();
    });
  })();
</script>
