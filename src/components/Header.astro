---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import { languages } from '../i18n/ui';
import { siteConfig } from '../site';

interface Props {
  navItems?: { name: string; href: string }[];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const { navItems = [
  { name: t('nav.home'), href: translatePath('/') },
  { name: t('nav.features'), href: '#features' },
  { name: t('nav.about'), href: '#about' },
  { name: t('nav.resources'), href: '#resources' },
] } = Astro.props;
---

<header class="sticky top-0 z-50 w-full border-b border-arena-edge bg-arena-base/95 backdrop-blur-md">
  <div class="container mx-auto px-4 h-16 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <a href={translatePath('/')} class="flex items-center gap-2">
        <div class="w-8 h-8 bg-arena-accent rounded-md flex items-center justify-center text-white font-bold">M</div>
        <span class="text-xl font-bold tracking-tight text-arena-ink">{siteConfig.projectName}</span>
      </a>
    </div>

    <nav class="hidden md:flex items-center gap-8">
      {navItems.map(item => (
        <a href={item.href} class="text-sm font-medium text-arena-muted hover:text-arena-ink transition-colors">
          {item.name}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-4">
      <div class="flex items-center gap-2 border-r border-arena-edge pr-4 mr-2">
        {Object.entries(languages).map(([l, label]) => (
          <a
            href={translatePath(Astro.url.pathname.replace(`/${lang}`, '') || '/', l)}
            class={`text-xs px-2 py-1 rounded-md transition-colors ${lang === l ? 'bg-arena-raised text-arena-ink font-bold' : 'text-arena-faint hover:text-arena-ink'}`}
          >
            {l === 'zh-cn' ? '中' : 'EN'}
          </a>
        ))}
      </div>

      <div class="hidden sm:flex items-center gap-3">
        <a
          href={siteConfig.docsUrl}
          target="_blank"
          rel="noreferrer"
          class="text-sm font-medium text-arena-muted hover:text-arena-ink"
        >
          {t('nav.docs')}
        </a>
        <a
          href={siteConfig.demoUrl}
          target="_blank"
          rel="noreferrer"
          class="bg-arena-accent text-white px-4 py-2 rounded-md text-sm font-medium hover:opacity-90 transition-opacity"
        >
          {t('nav.demo')}
        </a>
      </div>
    </div>
  </div>
</header>
