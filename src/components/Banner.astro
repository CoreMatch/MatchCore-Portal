---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { siteConfig } from '../site';

interface Props {
  pageUi?: any;
  projectName?: string;
  primaryHref?: string;
  secondaryHref?: string;
}

const {
  pageUi,
  projectName = siteConfig.projectName,
  primaryHref = siteConfig.demoUrl,
  secondaryHref = siteConfig.docsUrl,
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang, pageUi);
---

<section class="border-b border-arena-edge bg-arena-base py-20">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-5xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="mb-4 inline-flex items-center rounded-md border border-arena-edge bg-arena-panel px-4 py-1.5 text-sm text-arena-muted">
          {t('banner.badge')}
        </p>
        <h1 class="mb-4 text-4xl font-extrabold leading-tight tracking-tight text-arena-ink md:text-[52px]">
          {projectName}
        </h1>
        <p class="mx-auto mb-6 max-w-3xl text-lg font-medium text-arena-accent md:text-2xl">
          {t('banner.subtitle')}
        </p>
        <p class="mx-auto mb-8 max-w-2xl text-base leading-relaxed text-arena-muted">
          {t('banner.description')}
        </p>

        <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href={primaryHref}
            target="_blank"
            rel="noreferrer"
            class="w-full rounded-md bg-arena-accent px-8 py-4 text-center font-semibold text-white transition-opacity hover:opacity-90 sm:w-auto"
          >
            {t('banner.ctaPrimary')}
          </a>
          <a
            href={secondaryHref}
            target="_blank"
            rel="noreferrer"
            class="w-full rounded-md border border-arena-edge-strong bg-arena-panel px-8 py-4 text-center font-semibold text-arena-ink transition-colors hover:border-arena-faint sm:w-auto"
          >
            {t('banner.ctaSecondary')}
          </a>
        </div>
      </div>

      <div class="mt-12 grid gap-4 md:grid-cols-3">
        <div class="rounded-lg border border-arena-edge bg-arena-panel p-5 text-left">
          <p class="text-sm text-arena-faint">{t('banner.stat1.label')}</p>
          <p class="mt-2 text-base font-semibold text-arena-ink">{t('banner.stat1.value')}</p>
        </div>
        <div class="rounded-lg border border-arena-edge bg-arena-panel p-5 text-left">
          <p class="text-sm text-arena-faint">{t('banner.stat2.label')}</p>
          <p class="mt-2 text-base font-semibold text-arena-ink">{t('banner.stat2.value')}</p>
        </div>
        <div class="rounded-lg border border-arena-edge bg-arena-panel p-5 text-left">
          <p class="text-sm text-arena-faint">{t('banner.stat3.label')}</p>
          <p class="mt-2 text-base font-semibold text-arena-ink">{t('banner.stat3.value')}</p>
        </div>
      </div>
    </div>
  </div>
</section>
