---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="relative py-20 overflow-hidden bg-white">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-blue-50 via-transparent to-transparent opacity-70"></div>
  
  <div class="container relative mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-900 mb-6 leading-tight">
        {t('banner.title')} <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">{t('banner.titleAccent')}</span>
      </h1>
      <p class="text-lg md:text-xl text-gray-600 mb-10 leading-relaxed">
        {t('banner.description')}
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#" class="w-full sm:w-auto px-8 py-4 bg-blue-600 text-white rounded-xl font-semibold hover:bg-blue-700 transition-all shadow-lg shadow-blue-200 hover:-translate-y-0.5">
          {t('banner.ctaPrimary')}
        </a>
        <a href="#" class="w-full sm:w-auto px-8 py-4 bg-white text-gray-700 border border-gray-200 rounded-xl font-semibold hover:bg-gray-50 transition-all hover:border-gray-300">
          {t('banner.ctaSecondary')}
        </a>
      </div>

      <div class="mt-16 relative">
        <div class="absolute -inset-1 bg-gradient-to-r from-blue-100 to-indigo-100 rounded-2xl blur opacity-30"></div>
        <img 
          src="https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Modern+SaaS+dashboard+interface+with+clean+UI+charts+and+analytics+minimalist+design+soft+colors+high+resolution&image_size=landscape_16_9" 
          alt="Dashboard Preview" 
          class="relative rounded-2xl border border-gray-100 shadow-2xl"
        />
      </div>
    </div>
  </div>
</section>
