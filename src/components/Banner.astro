---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { siteConfig } from '../site';

interface Props {
  pageUi?: any;
}

const { pageUi } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang, pageUi);
---

<section class="relative overflow-hidden bg-white py-20">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-blue-50 via-transparent to-transparent opacity-70"></div>
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blue-200 to-transparent"></div>
  
  <div class="container relative mx-auto px-4">
    <div class="mx-auto max-w-5xl">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-6 inline-flex items-center rounded-full border border-blue-100 bg-blue-50 px-4 py-1.5 text-sm font-medium text-blue-700">
          {t('banner.badge')}
        </div>
        <h1 class="mb-4 text-4xl font-extrabold leading-tight tracking-tight text-gray-900 md:text-6xl">
          {siteConfig.projectName}
        </h1>
        <p class="mx-auto mb-6 max-w-3xl text-lg font-medium text-blue-700 md:text-2xl">
          {t('banner.subtitle')}
        </p>
        <p class="mb-10 text-lg leading-relaxed text-gray-600 md:text-xl">
          {t('banner.description')}
        </p>
      
        <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href={siteConfig.docsUrl}
            target="_blank"
            rel="noreferrer"
            class="w-full rounded-xl bg-blue-600 px-8 py-4 text-center font-semibold text-white transition-all shadow-lg shadow-blue-200 hover:-translate-y-0.5 hover:bg-blue-700 sm:w-auto"
          >
            {t('banner.ctaPrimary')}
          </a>
          <a
            href={siteConfig.demoUrl}
            target="_blank"
            rel="noreferrer"
            class="w-full rounded-xl border border-gray-200 bg-white px-8 py-4 text-center font-semibold text-gray-700 transition-all hover:border-gray-300 hover:bg-gray-50 sm:w-auto"
          >
            {t('banner.ctaSecondary')}
          </a>
        </div>
      </div>

      <div class="mt-12 grid gap-4 md:grid-cols-3">
        <div class="rounded-2xl border border-gray-100 bg-gray-50 p-5 text-left shadow-sm">
          <p class="text-sm text-gray-500">{t('banner.stat1.label')}</p>
          <p class="mt-2 text-base font-semibold text-gray-900">{t('banner.stat1.value')}</p>
        </div>
        <div class="rounded-2xl border border-gray-100 bg-gray-50 p-5 text-left shadow-sm">
          <p class="text-sm text-gray-500">{t('banner.stat2.label')}</p>
          <p class="mt-2 text-base font-semibold text-gray-900">{t('banner.stat2.value')}</p>
        </div>
        <div class="rounded-2xl border border-gray-100 bg-gray-50 p-5 text-left shadow-sm">
          <p class="text-sm text-gray-500">{t('banner.stat3.label')}</p>
          <p class="mt-2 text-base font-semibold text-gray-900">{t('banner.stat3.value')}</p>
        </div>
      </div>

      <div class="relative mt-12">
        <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-blue-100 to-indigo-100 opacity-30 blur"></div>
        <img
          src="https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Developer+portal+dashboard+for+Minecraft+authentication+and+skin+management%2C+modern+dark+and+light+UI%2C+account+identity+panels%2C+avatar+skin+preview+cards%2C+clean+developer+tool+design%2C+high+fidelity%2C+realistic+product+interface&image_size=landscape_16_9"
          alt="MatchCore portal preview"
          class="relative rounded-2xl border border-gray-100 shadow-2xl"
        />
      </div>
    </div>
  </div>
</section>
